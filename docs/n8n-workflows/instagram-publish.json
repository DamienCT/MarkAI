{
  "name": "MARKAI - Instagram Publish",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "markai/publish/instagram",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ig-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "markai-publish-instagram"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-caption",
              "name": "full_caption",
              "value": "={{ $json.body.caption }}{{ $json.body.hashtags && $json.body.hashtags.length > 0 ? '\\n\\n' + $json.body.hashtags.map(t => '#' + t).join(' ') : '' }}",
              "type": "string"
            },
            {
              "id": "set-content-id",
              "name": "content_id",
              "value": "={{ $json.body.content_id }}",
              "type": "string"
            },
            {
              "id": "set-ig-account",
              "name": "instagram_account_id",
              "value": "={{ $json.body.instagram_account_id }}",
              "type": "string"
            },
            {
              "id": "set-access-token",
              "name": "access_token",
              "value": "={{ $json.body.meta_access_token }}",
              "type": "string"
            },
            {
              "id": "set-image-url",
              "name": "image_url",
              "value": "={{ $json.body.image_url }}",
              "type": "string"
            },
            {
              "id": "set-channel",
              "name": "channel",
              "value": "instagram",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ig-set-vars",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.instagram_account_id }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $json.image_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.full_caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "ig-create-container",
      "name": "Create Media Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Set Variables').item.json.instagram_account_id }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $('Set Variables').item.json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "ig-publish",
      "name": "Publish Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MARKAI_API_URL || 'http://backend:8000' }}/api/v1/webhooks/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content_id",
              "value": "={{ $('Set Variables').item.json.content_id }}"
            },
            {
              "name": "status",
              "value": "published"
            },
            {
              "name": "platform_post_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "published_at",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "ig-callback-success",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MARKAI_API_URL || 'http://backend:8000' }}/api/v1/webhooks/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content_id",
              "value": "={{ $('Set Variables').item.json.content_id }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "error_message",
              "value": "={{ $json.error?.message || $json.message || 'Instagram publish failed at container creation' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "ig-callback-fail-container",
      "name": "Callback Fail (Container)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MARKAI_API_URL || 'http://backend:8000' }}/api/v1/webhooks/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content_id",
              "value": "={{ $('Set Variables').item.json.content_id }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "error_message",
              "value": "={{ $json.error?.message || $json.message || 'Instagram publish failed at media_publish step' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "ig-callback-fail-publish",
      "name": "Callback Fail (Publish)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 520]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', content_id: $('Set Variables').item.json.content_id }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "ig-respond-accepted",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1350, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', content_id: $('Set Variables').item.json.content_id }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "ig-respond-fail",
      "name": "Respond Fail",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1350, 520]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Set Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Variables": {
      "main": [
        [
          {
            "node": "Create Media Container",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Media Container": {
      "main": [
        [
          {
            "node": "Publish Media",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Callback Fail (Container)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish Media": {
      "main": [
        [
          {
            "node": "Callback Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Callback Fail (Publish)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback Success": {
      "main": [
        [
          {
            "node": "Respond Accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback Fail (Container)": {
      "main": [
        [
          {
            "node": "Respond Fail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback Fail (Publish)": {
      "main": [
        [
          {
            "node": "Respond Fail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "MARKAI"
    },
    {
      "name": "publish"
    },
    {
      "name": "instagram"
    }
  ],
  "triggerCount": 1,
  "pinData": {}
}
