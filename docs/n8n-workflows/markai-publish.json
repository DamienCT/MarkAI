{
  "name": "MARKAI - Unified Publisher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "markai/publish",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [250, 400],
      "webhookId": "markai-publish"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "content_id", "value": "={{ $json.body.content_id }}", "type": "stringValue" },
            { "id": "a2", "name": "channel", "value": "={{ $json.body.channel }}", "type": "stringValue" },
            { "id": "a3", "name": "full_text", "value": "={{ ($json.body.caption || '') + ($json.body.hashtags && $json.body.hashtags.length > 0 ? '\\n\\n' + $json.body.hashtags.map(t => '#' + t).join(' ') : '') }}", "type": "stringValue" },
            { "id": "a4", "name": "image_url", "value": "={{ $json.body.image_url || '' }}", "type": "stringValue" },
            { "id": "a5", "name": "meta_access_token", "value": "={{ $json.body.meta_access_token || '' }}", "type": "stringValue" },
            { "id": "a6", "name": "instagram_account_id", "value": "={{ $json.body.instagram_account_id || '' }}", "type": "stringValue" },
            { "id": "a7", "name": "page_id", "value": "={{ $json.body.page_id || '' }}", "type": "stringValue" },
            { "id": "a8", "name": "linkedin_access_token", "value": "={{ $json.body.linkedin_access_token || '' }}", "type": "stringValue" },
            { "id": "a9", "name": "linkedin_org_id", "value": "={{ $json.body.linkedin_org_id || '' }}", "type": "stringValue" },
            { "id": "a10", "name": "callback_url", "value": "={{ $env.MARKAI_API_URL || 'http://backend:8000' }}", "type": "stringValue" },
            { "id": "a11", "name": "webhook_secret", "value": "={{ $env.N8N_WEBHOOK_SECRET || '' }}", "type": "stringValue" }
          ]
        },
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000002",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [470, 400]
    },
    {
      "parameters": {
        "mode": "expression",
        "output": "={{ {'instagram': 0, 'facebook': 1, 'linkedin': 2}[$json.channel] ?? 3 }}",
        "numberOutputs": 4,
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000003",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [690, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v25.0/{{ $json.instagram_account_id }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "image_url", "value": "={{ $json.image_url }}" },
            { "name": "caption", "value": "={{ $json.full_text }}" },
            { "name": "access_token", "value": "={{ $json.meta_access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000004",
      "name": "IG Create Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [940, 200],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v25.0/{{ $('Set Variables').item.json.instagram_account_id }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "creation_id", "value": "={{ $json.id }}" },
            { "name": "access_token", "value": "={{ $('Set Variables').item.json.meta_access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000005",
      "name": "IG Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1160, 200],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v25.0/{{ $json.page_id }}/feed",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "message", "value": "={{ $json.full_text }}" },
            { "name": "link", "value": "={{ $json.image_url }}" },
            { "name": "access_token", "value": "={{ $json.meta_access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000006",
      "name": "FB Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [940, 400],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.linkedin_access_token }}" },
            { "name": "LinkedIn-Version", "value": "202603" },
            { "name": "X-Restli-Protocol-Version", "value": "2.0.0" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"author\": \"urn:li:organization:{{ $json.linkedin_org_id }}\",\n  \"commentary\": {{ JSON.stringify($json.full_text) }},\n  \"visibility\": \"PUBLIC\",\n  \"distribution\": { \"feedDistribution\": \"MAIN_FEED\" },\n  \"lifecycleState\": \"PUBLISHED\"\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000007",
      "name": "LinkedIn Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [940, 600],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Variables').item.json.callback_url }}/api/v1/webhooks/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{ $('Set Variables').item.json.webhook_secret }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"content_id\": \"{{ $('Set Variables').item.json.content_id }}\",\n  \"status\": \"published\",\n  \"platform_post_id\": \"{{ $json.id || ($json.headers && $json.headers['x-restli-id']) || 'unknown' }}\",\n  \"published_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000008",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1380, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Variables').item.json.callback_url }}/api/v1/webhooks/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{ $('Set Variables').item.json.webhook_secret }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"content_id\": \"{{ $('Set Variables').item.json.content_id }}\",\n  \"status\": \"failed\",\n  \"error_message\": {{ JSON.stringify(($json.error && ($json.error.message || $json.error.description)) || 'Publish failed') }}\n}",
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000010",
      "name": "Callback Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1380, 700]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Variables').item.json.callback_url }}/api/v1/webhooks/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{ $('Set Variables').item.json.webhook_secret }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"content_id\": \"{{ $('Set Variables').item.json.content_id }}\",\n  \"status\": \"failed\",\n  \"error_message\": \"channel_not_implemented\"\n}",
        "options": {}
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000009",
      "name": "Callback Not Implemented",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [940, 800]
    }
  ],
