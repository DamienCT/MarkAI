    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build the success-callback body and sign it (requires NODE_FUNCTION_ALLOW_BUILTIN=crypto).\nconst crypto = require('crypto');\nconst sv = $('Set Variables').item.json;\nconst postId = $json.id || ($json.headers && $json.headers['x-restli-id']) || 'unknown';\nconst body = JSON.stringify({\n  content_id: sv.content_id,\n  status: 'published',\n  platform_post_id: String(postId),\n  published_at: new Date().toISOString(),\n});\nconst timestamp = Math.floor(Date.now() / 1000).toString();\n// Echo the backend's dispatch event id so replayed callbacks dedup; fall back to a fresh uuid.\nconst eventId = sv.event_id || crypto.randomUUID();\nconst signature = sv.hmac_secret\n  ? 'sha256=' + crypto.createHmac('sha256', sv.hmac_secret).update(timestamp + '.' + body).digest('hex')\n  : '';\nreturn { json: { body_raw: body, timestamp, event_id: eventId, signature } };"
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000011",
      "name": "Sign Success Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1380, 400]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build the failure-callback body and sign it (requires NODE_FUNCTION_ALLOW_BUILTIN=crypto).\nconst crypto = require('crypto');\nconst sv = $('Set Variables').item.json;\nconst errMsg = ($json.error && ($json.error.message || $json.error.description)) || 'Publish failed';\nconst body = JSON.stringify({\n  content_id: sv.content_id,\n  status: 'failed',\n  error_message: errMsg,\n});\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst eventId = sv.event_id || crypto.randomUUID();\nconst signature = sv.hmac_secret\n  ? 'sha256=' + crypto.createHmac('sha256', sv.hmac_secret).update(timestamp + '.' + body).digest('hex')\n  : '';\nreturn { json: { body_raw: body, timestamp, event_id: eventId, signature } };"
      },
      "id": "c1a1a1a1-0001-4000-8000-000000000012",
      "name": "Sign Failed Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
