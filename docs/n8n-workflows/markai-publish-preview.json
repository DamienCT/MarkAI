{
  "name": "MARKAI - Publish Preview (inspect before publishing)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "markai/publish",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "b1b1b1b1-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [250, 400],
      "webhookId": "markai-publish"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "content_id", "value": "={{ $json.body.content_id }}", "type": "stringValue" },
            { "id": "a2", "name": "channel", "value": "={{ $json.body.channel }}", "type": "stringValue" },
            { "id": "a3", "name": "caption", "value": "={{ $json.body.caption || '' }}", "type": "stringValue" },
            { "id": "a4", "name": "hashtags", "value": "={{ $json.body.hashtags && $json.body.hashtags.length > 0 ? $json.body.hashtags.map(t => '#' + t).join(' ') : '' }}", "type": "stringValue" },
            { "id": "a5", "name": "full_text", "value": "={{ ($json.body.caption || '') + ($json.body.hashtags && $json.body.hashtags.length > 0 ? '\\n\\n' + $json.body.hashtags.map(t => '#' + t).join(' ') : '') }}", "type": "stringValue" },
            { "id": "a6", "name": "image_url", "value": "={{ $json.body.image_url || '' }}", "type": "stringValue" },
            { "id": "a7", "name": "headline", "value": "={{ $json.body.headline || '' }}", "type": "stringValue" },
            { "id": "a8", "name": "cta", "value": "={{ $json.body.cta || '' }}", "type": "stringValue" },
            { "id": "a9", "name": "brand_name", "value": "={{ $json.body.brand_name || '' }}", "type": "stringValue" },
            { "id": "a10", "name": "calendar_item_id", "value": "={{ $json.body.calendar_item_id || '' }}", "type": "stringValue" },
            { "id": "a11", "name": "received_at", "value": "={{ new Date().toISOString() }}", "type": "stringValue" }
          ]
        },
        "options": {}
      },
      "id": "b1b1b1b1-0001-4000-8000-000000000002",
      "name": "Extract Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 400]
    },
    {
      "parameters": {
        "content": "## Publish Request Received\n\n**Brand:** {{ $json.brand_name }}\n**Channel:** {{ $json.channel }}\n**Content ID:** {{ $json.content_id }}\n**Calendar Item:** {{ $json.calendar_item_id }}\n**Received:** {{ $json.received_at }}\n\n---\n\n### Headline\n{{ $json.headline }}\n\n### Caption\n{{ $json.caption }}\n\n### Hashtags\n{{ $json.hashtags }}\n\n### CTA\n{{ $json.cta }}\n\n### Image URL\n{{ $json.image_url }}\n\n### Full Post Text\n{{ $json.full_text }}",
        "height": 500,
        "width": 400
      },
      "id": "b1b1b1b1-0001-4000-8000-000000000003",
      "name": "Preview Content",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [740, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"received\",\n  \"content_id\": \"{{ $json.content_id }}\",\n  \"channel\": \"{{ $json.channel }}\",\n  \"message\": \"Publish request received in n8n preview mode. No actual publishing performed.\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b1b1b1b1-0001-4000-8000-000000000004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [740, 400]
    },
    {
      "parameters": {
        "content": "## How to use this workflow\n\n1. **Activate** this workflow (toggle ON)\n2. The app sends publish requests to: `POST /webhook/markai/publish`\n3. Open **Executions** to see each request's data\n4. Inspect the image URL, caption, hashtags, and channel\n5. Once satisfied, replace this with the full `markai-publish.json` workflow\n\nThis workflow does NOT publish anything — it just accepts the request and responds OK.",
        "height": 280,
        "width": 400
      },
      "id": "b1b1b1b1-0001-4000-8000-000000000005",
      "name": "Instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [250, 100]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Extract Fields", "type": "main", "index": 0 }]]
    },
    "Extract Fields": {
      "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
