# ============================================================
# MARKAI VPS Production Environment
# ============================================================
# Copy to .env and fill in ALL values before deploying.
# Lines marked [REQUIRED] must be set — deployment will fail without them.
# Lines marked [CHANGE-ME] must be changed from the default.
# ============================================================

# ── General ──────────────────────────────────────────────────
MARKAI_ENV=production
MARKAI_DOMAIN=markai.srv1191974.hstgr.cloud                     # [REQUIRED]
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32           # [CHANGE-ME]

# ── Microsoft Entra ID (SSO) ────────────────────────────────
AZURE_AD_TENANT_ID=                                              # [REQUIRED]
AZURE_AD_CLIENT_ID=                                              # [REQUIRED]
AZURE_AD_CLIENT_SECRET=                                          # [REQUIRED]
ADMIN_SECURITY_GROUP_ID=                                         # [REQUIRED]
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=                                  # [REQUIRED] Same as AZURE_AD_CLIENT_ID
NEXTAUTH_URL=https://markai.srv1191974.hstgr.cloud              # [REQUIRED]
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32     # [CHANGE-ME]

# ── Microsoft Fabric / Power BI ─────────────────────────────
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_SQL_ENDPOINT=
FABRIC_LAKEHOUSE_NAME=lh_bronze
BC_TABLE_ITEMS=itemmodule_item
BC_TABLE_ITEM_CATEGORIES=itemmodule_itemcategory
BC_TABLE_VENDORS=vendormodule_vendor
BC_TABLE_ITEM_LEDGER_ENTRIES=itemmodule_itemledgerentry

# ── AI API Keys ──────────────────────────────────────────────
OPENAI_API_KEY=                                                  # [REQUIRED]
GEMINI_API_KEY=                                                  # [REQUIRED]

# ── LiteLLM ─────────────────────────────────────────────────
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32  # [CHANGE-ME]

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=markai
POSTGRES_USER=markai
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD             # [CHANGE-ME]

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_GENERATE_STRONG_PASSWORD              # [CHANGE-ME]

# ── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=markai-minio
MINIO_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_PASSWORD              # [CHANGE-ME]
MINIO_BUCKET=markai-assets

# ── Valkey ───────────────────────────────────────────────────
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD              # [CHANGE-ME]

# ── NATS ─────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── n8n (your existing n8n server) ───────────────────────────
# N8N_BASE_URL: your n8n dashboard URL (for links in the UI)
# N8N_WEBHOOK_BASE: the webhook root — backend appends /markai/publish
N8N_BASE_URL=https://n8n.srv1191974.hstgr.cloud
N8N_WEBHOOK_BASE=https://n8n.srv1191974.hstgr.cloud/webhook
N8N_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32  # [CHANGE-ME]

# ── Production URLs ──────────────────────────────────────────
FRONTEND_URL=https://markai.srv1191974.hstgr.cloud               # [REQUIRED] CORS origin
NEXT_PUBLIC_API_URL=https://api.markai.srv1191974.hstgr.cloud    # [REQUIRED] Frontend→Backend

# ── Internal services ────────────────────────────────────────
BROWSER_WORKER_URL=http://browser-worker:8001

# ── LangSmith (optional) ────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=markai

# ── Grafana ─────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN             # [CHANGE-ME]

# ============================================================
# NOTE: Social platform credentials (Meta, LinkedIn, etc.) are
# configured per-brand in the UI, not here. Scheduler settings
# have sensible defaults in the app — override in Settings UI.
# ============================================================

