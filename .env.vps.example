# ============================================================
# MARKAI VPS Production Environment
# ============================================================
# Copy to .env and fill in ALL values before deploying.
# Lines marked [REQUIRED] must be set — deployment will fail without them.
# Lines marked [CHANGE-ME] must be changed from the default — startup will refuse insecure defaults.
# ============================================================

# ── General ──────────────────────────────────────────────────
MARKAI_ENV=production
MARKAI_DOMAIN=markai.srv1191974.hstgr.cloud                     # [REQUIRED] Your domain
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32           # [CHANGE-ME] openssl rand -hex 32

# ── Microsoft Entra ID (SSO) ────────────────────────────────
AZURE_AD_TENANT_ID=                                              # [REQUIRED] Azure AD tenant
AZURE_AD_CLIENT_ID=                                              # [REQUIRED] App registration client ID
AZURE_AD_CLIENT_SECRET=                                          # [REQUIRED] App registration secret
ADMIN_SECURITY_GROUP_ID=                                         # [REQUIRED] Entra group for admin role

# Frontend SSO (must be NEXT_PUBLIC_ to be in client bundle)
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=                                  # [REQUIRED] Same as AZURE_AD_CLIENT_ID

# NextAuth
NEXTAUTH_URL=https://markai.srv1191974.hstgr.cloud              # [REQUIRED] Must match frontend URL exactly
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32     # [CHANGE-ME] openssl rand -hex 32

# ── Microsoft Fabric / Power BI ─────────────────────────────
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_SQL_ENDPOINT=
FABRIC_LAKEHOUSE_NAME=lh_bronze

# Business Central table names
BC_TABLE_ITEMS=itemmodule_item
BC_TABLE_ITEM_CATEGORIES=itemmodule_itemcategory
BC_TABLE_VENDORS=vendormodule_vendor
BC_TABLE_ITEM_LEDGER_ENTRIES=itemmodule_itemledgerentry

# ── AI API Keys ──────────────────────────────────────────────
OPENAI_API_KEY=                                                  # [REQUIRED] OpenAI API key
GEMINI_API_KEY=                                                  # [REQUIRED] Google Gemini API key

# ── LiteLLM ─────────────────────────────────────────────────
LITELLM_BASE_URL=http://litellm:4000                             # Internal Docker hostname
LITELLM_MASTER_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32  # [CHANGE-ME]

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres                                           # Internal Docker hostname
POSTGRES_PORT=5432
POSTGRES_DB=markai
POSTGRES_USER=markai
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD             # [CHANGE-ME]

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_HOST=qdrant                                               # Internal Docker hostname
QDRANT_PORT=6333

# ── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000                                        # Internal Docker hostname
MINIO_ACCESS_KEY=markai-minio
MINIO_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_PASSWORD              # [CHANGE-ME]
MINIO_BUCKET=markai-assets

# ── Valkey (Redis) ───────────────────────────────────────────
VALKEY_HOST=valkey                                               # Internal Docker hostname
VALKEY_PORT=6379

# ── NATS ─────────────────────────────────────────────────────
NATS_URL=nats://nats:4222                                        # Internal Docker hostname

# ── n8n ──────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.markai.srv1191974.hstgr.cloud
N8N_WEBHOOK_BASE=https://n8n.markai.srv1191974.hstgr.cloud/webhook
N8N_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32  # [CHANGE-ME]

# ── URLs (production) ───────────────────────────────────────
FRONTEND_URL=https://markai.srv1191974.hstgr.cloud               # [REQUIRED] For CORS
NEXT_PUBLIC_API_URL=https://api.markai.srv1191974.hstgr.cloud    # [REQUIRED] Frontend → Backend

# ── Browser Worker ───────────────────────────────────────────
BROWSER_WORKER_URL=http://browser-worker:8001                    # Internal Docker hostname

# ── LangSmith (optional) ────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=markai

# ── Notifications (Teams) ───────────────────────────────────
TEAMS_WEBHOOK_URL=                                               # Microsoft Teams incoming webhook URL

# ── Social Platform API Keys ────────────────────────────────
META_ACCESS_TOKEN=                                               # Meta long-lived page token
META_PAGE_ID=                                                    # Facebook page ID
META_INSTAGRAM_ACCOUNT_ID=                                       # Instagram business account ID
LINKEDIN_ACCESS_TOKEN=                                           # LinkedIn OAuth token
LINKEDIN_ORG_ID=                                                 # LinkedIn organization URN

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Indian/Mauritius
MORNING_SCHEDULE_HOUR=6
MORNING_SCHEDULE_MINUTE=0
PUBLISH_CHECK_INTERVAL_MINUTES=15
ENGAGEMENT_PULL_INTERVAL_HOURS=6
BC_SYNC_INTERVAL_HOURS=6
