# MARKAI Environment Configuration
MARKAI_ENV=development
MARKAI_DOMAIN=markai.example.com
SECRET_KEY=your-random-secret-key-here

# Microsoft Entra ID (SSO)
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
NEXTAUTH_URL=https://markai.example.com
NEXTAUTH_SECRET=your-nextauth-secret-here

# Microsoft Entra ID Security Groups
# Members of ADMIN group are auto-provisioned as active admins.
# Members of MARKETING group are auto-provisioned as active managers.
ADMIN_SECURITY_GROUP_ID=your-security-group-object-id
MARKETING_SECURITY_GROUP_ID=your-marketing-group-object-id

# Microsoft Entra ID (Fabric / Power BI)
FABRIC_TENANT_ID=your-fabric-tenant-id
FABRIC_CLIENT_ID=your-fabric-client-id
FABRIC_CLIENT_SECRET=your-fabric-client-secret
FABRIC_SQL_ENDPOINT=your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_LAKEHOUSE_NAME=lh_bronze

# Business Central Tables
BC_TABLE_ITEMS=itemmodule_item
BC_TABLE_ITEM_CATEGORIES=itemmodule_itemcategory
BC_TABLE_VENDORS=vendormodule_vendor
BC_TABLE_ITEM_LEDGER_ENTRIES=itemmodule_itemledgerentry

# OpenAI (via LiteLLM)
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# LiteLLM
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-your-litellm-master-key

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=markai
POSTGRES_USER=markai
POSTGRES_PASSWORD=your-strong-password

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=markai-minio
MINIO_SECRET_KEY=your-strong-password
MINIO_BUCKET=markai-assets

# Valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=your-valkey-password

# NATS
NATS_URL=nats://nats:4222

# Frontend
FRONTEND_URL=http://localhost:3000

# n8n (social publishing only)
N8N_BASE_URL=https://n8n.example.com
N8N_WEBHOOK_BASE=https://n8n.example.com/webhook
N8N_WEBHOOK_SECRET=your-webhook-secret

# Playwright Browser Worker
BROWSER_WORKER_URL=http://browser-worker:8001

# OpenTelemetry (optional – leave empty to disable tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=

# LangSmith (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=markai

# Notifications (Microsoft Teams)
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/your-webhook-id

# Social Platform API Keys — Instagram & Facebook (Meta)
META_ACCESS_TOKEN=your-long-lived-page-token
META_PAGE_ID=your-facebook-page-id
META_INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your-linkedin-token
LINKEDIN_ORG_ID=your-linkedin-org-urn

# YouTube (Google/YouTube Data API v3)
YOUTUBE_CLIENT_ID=your-google-client-id
YOUTUBE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# X / Twitter (API v2)
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# Scheduler
# Traefik Dashboard (htpasswd -nbB admin 'your-password')
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$REPLACE_WITH_REAL_BCRYPT_HASH

# Scheduler
SCHEDULER_TIMEZONE=Indian/Mauritius

# Grafana
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin
MORNING_SCHEDULE_HOUR=6
MORNING_SCHEDULE_MINUTE=0
PUBLISH_CHECK_INTERVAL_MINUTES=15
ENGAGEMENT_PULL_INTERVAL_HOURS=6
BC_SYNC_INTERVAL_HOURS=6

# Anthropic (Claude 5 family via LiteLLM — optional until key provided)
ANTHROPIC_API_KEY=

# Video generation (Forge local GPU gateway / fal.ai / Google Veo)
VIDEO_FORGE_URL=http://host.docker.internal:9100
VIDEO_FORGE_API_KEY=
FAL_API_KEY=
FAL_VIDEO_MODEL=fal-ai/ltx-2.3/image-to-video
VEO_MODEL=veo-3.1-fast-generate-preview
VIDEO_RENDER_TIMEOUT_S=2400
FAL_COST_PER_S=0.06
VEO_COST_PER_S=0.15
