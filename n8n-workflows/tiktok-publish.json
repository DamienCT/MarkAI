{
  "name": "MARKAI - TikTok Publish",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "markai/publish/tiktok",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "tt-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "markai-publish-tiktok"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-content-id",
              "name": "content_id",
              "value": "={{ $json.body.content_id }}",
              "type": "string"
            },
            {
              "id": "set-caption",
              "name": "full_caption",
              "value": "={{ $json.body.caption }}{{ $json.body.hashtags && $json.body.hashtags.length > 0 ? ' ' + $json.body.hashtags.map(t => '#' + t).join(' ') : '' }}",
              "type": "string"
            },
            {
              "id": "set-video-url",
              "name": "video_url",
              "value": "={{ $json.body.image_url }}",
              "type": "string"
            },
            {
              "id": "set-access-token",
              "name": "access_token",
              "value": "={{ $json.body.access_token }}",
              "type": "string"
            },
            {
              "id": "set-channel",
              "name": "channel",
              "value": "tiktok",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "tt-set-vars",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/inbox/video/init/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json; charset=UTF-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"post_info\": {\n    \"title\": {{ JSON.stringify($json.full_caption.substring(0, 150)) }},\n    \"privacy_level\": \"PUBLIC_TO_EVERYONE\",\n    \"disable_duet\": false,\n    \"disable_comment\": false,\n    \"disable_stitch\": false\n  },\n  \"source_info\": {\n    \"source\": \"PULL_FROM_URL\",\n    \"video_url\": {{ JSON.stringify($json.video_url) }}\n  }\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "tt-init-upload",
      "name": "Init Video Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/status/fetch/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Set Variables').item.json.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json; charset=UTF-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"publish_id\": {{ JSON.stringify($json.data.publish_id) }}\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "tt-check-status",
      "name": "Check Publish Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MARKAI_API_URL || 'http://backend:8000' }}/api/v1/webhooks/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content_id",
              "value": "={{ $('Set Variables').item.json.content_id }}"
            },
            {
              "name": "status",
              "value": "published"
            },
            {
              "name": "platform_post_id",
              "value": "={{ $json.data?.share_id || $('Init Video Post').item.json.data?.publish_id || '' }}"
            },
            {
              "name": "published_at",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "tt-callback-success",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MARKAI_API_URL || 'http://backend:8000' }}/api/v1/webhooks/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content_id",
              "value": "={{ $('Set Variables').item.json.content_id }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "error_message",
              "value": "={{ $json.error?.message || $json.error?.code || $json.message || 'TikTok publish failed' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "tt-callback-fail",
      "name": "Callback Fail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 540]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', content_id: $('Set Variables').item.json.content_id }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "tt-respond-ok",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1350, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', content_id: $('Set Variables').item.json.content_id }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "tt-respond-fail",
      "name": "Respond Fail",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1350, 540]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Set Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Variables": {
      "main": [
        [
          {
            "node": "Init Video Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Init Video Post": {
      "main": [
        [
          {
            "node": "Check Publish Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Callback Fail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Publish Status": {
      "main": [
        [
          {
            "node": "Callback Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Callback Fail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback Success": {
      "main": [
        [
          {
            "node": "Respond Accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback Fail": {
      "main": [
        [
          {
            "node": "Respond Fail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "MARKAI"
    },
    {
      "name": "publish"
    },
    {
      "name": "tiktok"
    }
  ],
  "triggerCount": 1,
  "pinData": {}
}
