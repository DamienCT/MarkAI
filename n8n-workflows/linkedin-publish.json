        "options": {
          "timeout": 30000
        }
      },
      "id": "li-post-text-only",
      "name": "Post Text Only",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 420],
      "onError": "continueErrorOutput"
